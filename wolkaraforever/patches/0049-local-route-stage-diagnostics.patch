# WolkaraForever layer patch 0049 - expose the failing local VPN route stage
#
# Diagnostic only: no route policy or retry behavior changes. The app writes the
# result to Documents/local-game-setup.txt before guest code enters.
# Applies to: authorization/App/LocalAuthorization.m
# Upstream: candidate after the device diagnosis.
#
diff --git a/authorization/App/LocalAuthorization.m b/authorization/App/LocalAuthorization.m
index 6feb7b1..31d4bde 100644
--- a/authorization/App/LocalAuthorization.m
+++ b/authorization/App/LocalAuthorization.m
@@ -45,6 +45,13 @@ static void TKWaitForStoppedRoute(NETunnelProviderManager *manager,CFTimeInterva
         TKWaitForStoppedRoute(manager,deadline,completion);
     });
 }
+// Report only the public error domain/code and the route stage; never include
+// pairing records, device identifiers or tunnel traffic in this report.
+static NSString *TKRouteFailure(NSString *stage,NSError *error) {
+    if (!error) return [stage stringByAppendingString:@" failed without a system error."];
+    return [NSString stringWithFormat:@"%@ failed (%@:%ld): %@",stage,
+        error.domain?:@"unknown",(long)error.code,error.localizedDescription?:@"unknown"];
+}
 @implementation TKLocalAuthorization
