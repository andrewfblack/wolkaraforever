+// The bookmark, its relative path and the files themselves are validated by
+// the layer; this call only records the validated result. A disconnected volume
+// fails here and leaves the existing record untouched.
+- (TKApp *)registerExternalExecutable:(NSString *)relative error:(NSError **)error {
+    if (![relative isEqual:[TKExternalGameRecord recordedExecutable]]) {
+        library_error(error,@"The executable does not match the registered external folder."); return nil;
+    }
+    NSURL *folder=[TKExternalGameRecord beginAccess:error];
+    if (!folder) return nil;
+    @try {
+        NSDictionary *paths=[TKExternalGameRecord validatedPathsWithFolder:folder error:error];
+        if (!paths || ![paths[@"executable"] hasSuffix:relative]) return nil;
+        NSString *hash=guest_module_hash(paths[@"executable"],NULL,error);
+        if (!hash) return nil;
+        return [self addRecord:@{@"source":@"external",@"name":@"Forever (SD card)",
+            @"executable":relative,@"workingDirectory":@"_forever_",@"sha256":hash} error:error];
+    } @finally { [TKExternalGameRecord endAccess:folder]; }
+}
+
